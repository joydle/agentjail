# Control-plane API keys: comma-separated `token@tenant:role` (role = admin|operator).
# Required. The server refuses to start without at least one valid entry.
# Generate one with: echo "aj_$(openssl rand -hex 16)@dev:admin"
AGENTJAIL_API_KEY=
# Dev only: start with no API key (every caller is admin). Never on a shared host.
# AGENTJAIL_DEV_INSECURE=1
PROXY_BASE_URL=http://server:8443

# Postgres password for the compose sidecar. No default; generate one:
#   openssl rand -hex 24
# (`make setup` does this for you.) Use URL-safe characters (hex is).
POSTGRES_PASSWORD=
DATABASE_URL=postgres://agentjail:${POSTGRES_PASSWORD}@postgres:5432/agentjail

# Published ports bind here. Default 127.0.0.1; 0.0.0.0 exposes them.
# AGENTJAIL_BIND=127.0.0.1

# Jail hardening (both default on).
# AGENTJAIL_USER_NAMESPACE=1
# AGENTJAIL_LANDLOCK=1

# Limits.
# AGENTJAIL_MAX_CONCURRENT=16
# AGENTJAIL_MAX_CONCURRENT_PER_TENANT=0     # 0 = only the global cap
# AGENTJAIL_MIN_MEMORY_MB=64
# AGENTJAIL_MAX_MEMORY_MB=8192
# AGENTJAIL_TOKEN_MAX_TTL_SECS=86400        # cap phantom-token lifetime

# Gateway SSRF guard: workspace backend_urls may only reach public
# addresses. `1` disables the guard (local dev against localhost only).
# AGENTJAIL_ALLOW_PRIVATE_BACKENDS=1

# Structured logging. `json` = one JSON object per line (prod + log
# aggregators); unset = compact single-line text (dev default).
# LOG_FORMAT=json
# RUST_LOG=info,agentjail_ctl=debug,agentjail_phantom=debug

# Persistent workspaces + named snapshots.
# All paths are created on startup if they don't exist.
AGENTJAIL_STATE_DIR=/var/lib/agentjail

# Snapshot retention. Both caps are optional; unset = no limit.
# AGENTJAIL_SNAPSHOT_MAX_AGE_SECS=604800   # 7 days
# AGENTJAIL_SNAPSHOT_MAX_COUNT=200
# AGENTJAIL_SNAPSHOT_GC_TICK_SECS=60

# Content-addressed incremental snapshots. When set, every snapshot
# stores file bodies in this shared pool (SHA-256 addressed) and writes
# a manifest; subsequent snapshots of the same files dedupe. Unset =
# classic full-copy snapshots.
# AGENTJAIL_SNAPSHOT_POOL_DIR=/var/lib/agentjail/snapshot-objects

# Workspace idle-reaper. Scans live workspaces on this interval and
# auto-pauses any with a per-workspace idleTimeoutSecs that has elapsed.
# Default 30s; set to 0 to disable.
# AGENTJAIL_IDLE_CHECK_INTERVAL_SECS=30

# Hostname-routed HTTP reverse proxy. When set, the server listens on
# this address and forwards incoming requests to the backend URL declared
# by the matching workspace's `domains` list. HTTP only (terminate TLS
# upstream). Unset = gateway listener disabled.
# AGENTJAIL_GATEWAY_ADDR=0.0.0.0:8080
