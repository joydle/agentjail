# Vite React UI — static build served by a lightweight Node server.

# Base images pinned by digest (supply chain): bump tag + digest together,
# e.g. `docker buildx imagetools inspect node:22-bookworm-slim`.
FROM node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d AS build
WORKDIR /app
COPY web/package.json web/bun.lock ./
RUN npm install --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d
RUN npm install -g serve@14.2.4 && useradd -r -u 10002 -m web
USER web
WORKDIR /home/web
COPY --from=build /app/dist /home/web/dist

ENV PORT=3000
EXPOSE 3000
CMD ["serve", "-s", "dist", "-l", "3000"]
